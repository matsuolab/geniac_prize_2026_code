# CapX ROBOSUITE env-backend container (3-tier, D7).
#
# Hosts ONE simulator (Robosuite/MuJoCo) as a LowLevelEnv backend — capx.gateway's
# EnvBackendServer — behind the (separate, sim-agnostic) gateway container. Its
# socket is in a volume only the gateway shares, never reachable by a submission;
# the gateway routes to it by TaskSpec.simulator (docker-compose.yml). Headless EGL rendering;
# mujoco is pinned to 3.5.0 because >=3.10 breaks robosuite's mj_fullM.
#
# NOTE: provided as a scaffold — NOT built or verified in this environment (needs a
# GPU host + full image build).

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    MUJOCO_GL=egl \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/capx \
    CAPX_SIMULATOR=robosuite \
    CAPX_BACKEND_UNIX=/capx/sock/robosuite.sock

# System deps: python 3.11 + headless GL/EGL libraries for MuJoCo.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-venv python3-pip \
        git build-essential \
        libgl1 libglx0 libegl1 libopengl0 libosmesa6 libglu1-mesa \
        libx11-6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && python -m ensurepip --upgrade \
    && python -m pip install --upgrade pip

WORKDIR /workspace/capx
COPY . /workspace/capx

# Sim stack only — NOT the full capx dependency set. The heavy perception/planning
# deps (sam3, curobo, contact_graspnet, vllm) are submission-side and their editable
# builds need a GPU toolchain, so the gateway image skips them. robosuite is the
# vendored editable copy; mujoco is pinned to the version robosuite works with.
# `--no-deps` on the editable installs keeps pip from pulling a conflicting mujoco.
RUN python -m pip install \
        "mujoco==3.5.0" \
        "numpy==1.26.4" \
        "scipy" \
        "pydantic>=2.7" \
        "pyyaml" \
        "pillow>=10" \
        "msgpack" \
        "gymnasium>=0.29" \
        "opencv-python-headless" \
        "viser>=0.2.0" \
        "matplotlib" \
        "h5py" \
        "robot_descriptions" \
        "yourdfpy" \
        "termcolor" \
        "numba==0.61.2" \
        "tqdm" \
    && python -m pip install --no-deps -e capx/third_party/robosuite \
    && python -m pip install --no-deps -e .

CMD ["python", "docker/serve_env_backend.py"]
