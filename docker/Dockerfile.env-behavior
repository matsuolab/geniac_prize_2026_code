# CapX BEHAVIOR env-backend container (3-tier, D7).
#
# Hosts ONE simulator (BEHAVIOR-1K / OmniGibson / Isaac Sim) as a LowLevelEnv
# backend — capx.gateway's EnvBackendServer — behind the (separate, sim-agnostic)
# gateway container. It sits on the internal sim_network only, never reachable by
# a submission; the gateway routes to it by TaskSpec.simulator (docker-compose.yml).
#
# Targets Blackwell (sm_120). The stack is upstream BEHAVIOR-1K v3.9.2:
# OmniGibson 3.9.2 + Isaac Sim 5.1.0 + torch 2.7.0+cu128. The Isaac Sim 4.5 stack
# that capx/third_party/b1k pins cannot run here: its Iray renderer rejects compute
# capability 12.0 and segfaults right after `app ready`.
#
# The base stage is upstream's own image, built from the pinned commit by the
# `behavior-base` compose service (docker/Dockerfile in that repo). It installs the
# conda env `behavior` at /opt/conda/envs/behavior, with cuRobo precompiled for
# sm_120. The backend never starts cuRobo: motion planning runs in the submission.
#
# Assets are NOT baked in. Fetch them once into the `behavior-assets` volume with
# `docker compose --profile assets run --rm fetch-behavior-assets`.
#
# Verified on an RTX PRO 6000 Blackwell (driver 580.65.06): a `picking_up_trash`
# episode driven through the gateway in dev and official mode, backend offline.

FROM behavior-base

# Upstream removes its temporary CUDA toolkit with `apt autoremove`, which on
# Ubuntu 24.04 also drops libraries Kit's window/UI bootstrap dlopens even when
# headless.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libasound2t64 libfontconfig1 libfreetype6 libglu1-mesa libgtk-3-0t64 libnss3 \
        libx11-6 libxcomposite1 libxcursor1 libxdamage1 libxfixes3 libxi6 libxinerama1 \
        libxrandr2 libxrender1 libxtst6 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/capx \
    CAPX_SIMULATOR=behavior \
    CAPX_BACKEND_HOST=0.0.0.0 \
    CAPX_BACKEND_PORT=8100 \
    OMNI_KIT_ACCEPT_EULA=YES \
    OMNIGIBSON_HEADLESS=1 \
    OMNIGIBSON_GPU_ID=0

WORKDIR /workspace/capx
COPY . /workspace/capx

# The behavior env already carries torch/numpy/scipy/omnigibson; add only what the
# protocol layer and the capx.envs.simulators import chain need on top. Every
# package already in the env is pinned to its installed version so nothing here
# can move the sim stack (numpy<2 in particular).
RUN /opt/conda/envs/behavior/bin/python -m pip list --format=freeze --exclude-editable > /tmp/behavior-pins.txt \
    && /opt/conda/envs/behavior/bin/python -m pip install -c /tmp/behavior-pins.txt \
        "pydantic>=2.7" pyyaml msgpack mediapy \
    && /opt/conda/envs/behavior/bin/python -m pip install --no-deps -e . \
    && rm /tmp/behavior-pins.txt

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "docker/serve_env_backend.py"]
