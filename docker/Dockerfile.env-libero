# CapX LIBERO env-backend container (3-tier, D7).
#
# Hosts ONE simulator (LIBERO/MuJoCo, via LIBERO's vendored robosuite) as a
# LowLevelEnv backend — capx.gateway's EnvBackendServer — behind the (separate,
# sim-agnostic) gateway container. Its socket is in a volume only the gateway
# shares, never reachable by a submission; the gateway routes to it by
# TaskSpec.simulator (docker-compose.yml). Headless EGL rendering.
#
# LIBERO and Robosuite ship incompatible vendored stacks (see
# capx/envs/simulators/__init__.py) — hence a separate image/venv from
# Dockerfile.env-robosuite, mirroring docker/setup-libero.sh's dependency set.
#
# NOTE: provided as a scaffold — NOT built or verified in this environment (needs a
# GPU host + full image build; see the PR description for what was verified instead).

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    MUJOCO_GL=egl \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/capx \
    CAPX_SIMULATOR=libero \
    CAPX_BACKEND_UNIX=/capx/sock/libero.sock

# System deps: python 3.11 + headless GL/EGL libraries for MuJoCo.
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-venv python3-pip \
        git build-essential cmake \
        libgl1 libglx0 libegl1 libopengl0 libosmesa6 libglu1-mesa \
        libx11-6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && python -m ensurepip --upgrade \
    && python -m pip install --upgrade pip

WORKDIR /workspace/capx
COPY . /workspace/capx

# Sim stack only — NOT the full capx dependency set (mirrors Dockerfile.env-robosuite).
# LIBERO vendors its own robosuite fork (libero_dependencies/robosuite); installing it
# `--no-deps` keeps pip from pulling Dockerfile.env-robosuite's mujoco/robosuite pins,
# since the two backends are mutually exclusive in one venv. The jax/pyroki block is
# what `capx.integrations` (pulled in by the LIBERO env modules) needs at import time,
# pinned to the versions uv.lock resolves; jaxls/pyroki go in `--no-deps` because they
# pin each other to different git refs than uv.lock resolves (pip can't reconcile
# the direct-URL requirements, uv can). open3d is installed `--ignore-installed`
# because its dep tree collides with a distutils-installed system package.
RUN python -m pip install \
        "mujoco==3.5.0" \
        "numpy==1.26.4" \
        "scipy" \
        "pydantic>=2.7" \
        "pyyaml" \
        "pillow>=10" \
        "msgpack" \
        "gymnasium>=0.29" \
        "opencv-python-headless" \
        "viser>=0.2.0" \
        "easydict==1.9" \
        "robomimic==0.2.0" \
        "einops==0.4.1" \
        "thop==0.1.1-2209072238" \
        "bddl==1.0.1" \
        "future==0.18.2" \
        "cloudpickle==2.1.0" \
        "gym==0.25.2" \
        "scikit-learn" \
        "matplotlib" \
        "h5py" \
        "robot_descriptions" \
        "yourdfpy" \
        "numba==0.61.2" \
        "jax==0.4.29" \
        "jaxlib==0.4.29" \
        "jax-dataclasses==1.6.3" \
        "jaxlie==1.5.0" \
        "jaxtyping" \
        "loguru" \
        "rich" \
    # numpy is respecified here or --ignore-installed would bump it past the pin
    && python -m pip install --ignore-installed "open3d==0.19.0" "numpy==1.26.4" \
    && python -m pip install --no-deps \
        "jaxls@git+https://github.com/brentyi/jaxls.git@6fe7cf9d56223736b2c0272d080ec7346203c648" \
        "pyroki@git+https://github.com/chungmin99/pyroki.git@95afccc22658c461ab1042a048ae4e9c24bc2a47" \
    && python -m pip install --no-deps -e capx/third_party/libero_dependencies/robosuite \
    && python -m pip install --no-deps -e capx/third_party/LIBERO-PRO \
    && python -m pip install --no-deps -e .

# LIBERO prompts interactively for asset paths on first import if this config is
# missing (EOFError headless) — mirror setup-libero.sh's config.yaml.
RUN mkdir -p /root/.libero && printf '%s\n' \
        "assets: /workspace/capx/capx/third_party/LIBERO-PRO/libero/libero/assets" \
        "bddl_files: /workspace/capx/capx/third_party/LIBERO-PRO/libero/libero/bddl_files" \
        "benchmark_root: /workspace/capx/capx/third_party/LIBERO-PRO/libero/libero" \
        "datasets: /workspace/capx/capx/third_party/LIBERO-PRO/libero/libero/../datasets" \
        "init_states: /workspace/capx/capx/third_party/LIBERO-PRO/libero/libero/init_files" \
        > /root/.libero/config.yaml

CMD ["python", "docker/serve_env_backend.py"]
